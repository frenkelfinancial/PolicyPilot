{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/a/:path*",
      "destination": "https://cweiaibjigjwspmshcrj.supabase.co/functions/v1/compliance-page/a/:path*"
    }
  ],
  "headers": [
    {
      "source": "/a/:path*",
      "headers": [
        { "key": "Content-Type", "value": "text/html; charset=utf-8" },
        { "key": "Content-Security-Policy", "value": "default-src 'none'; style-src 'unsafe-inline'; img-src data:; form-action 'self'; frame-ancestors 'none'; base-uri 'none'" },
        { "key": "X-Robots-Tag", "value": "index, follow" }
      ]
    }
  ]
}
