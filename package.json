{
  "name": "policypilot",
  "version": "1.0.0",
  "description": "PolicyPilot life insurance agent dashboard",
  "private": true,
  "scripts": {
    "check": "node scripts/check-app.mjs app.html",
    "preview": "node scripts/preview-server.mjs",
    "check:update-baseline": "node scripts/check-app.mjs --update-baseline app.html",
    "test:email": "node --test \"supabase/functions/_shared/email/*.test.ts\"",
    "test:messaging": "node --test \"supabase/functions/_shared/segments.test.ts\" \"supabase/functions/_shared/tcpa.test.ts\" \"supabase/functions/_shared/phone.test.ts\" \"supabase/functions/_shared/messaging-shared.test.ts\" \"supabase/functions/_shared/messaging-send-core.test.ts\" \"supabase/functions/_shared/broadcast-gate.test.ts\" \"supabase/functions/_shared/broadcast-pacing.test.ts\" \"supabase/functions/_shared/csv.test.ts\" \"supabase/functions/_shared/leads.test.ts\"",
    "test:ai": "node --test \"supabase/functions/_shared/ai-minute-billing.test.ts\" \"supabase/functions/_shared/ai-call-billing.test.ts\" \"supabase/functions/_shared/ai-call-outcome.test.ts\" \"supabase/functions/_shared/ai-appointment.test.ts\" \"supabase/functions/_shared/ai-assistant-start.test.ts\" \"supabase/functions/_shared/ai-inbound.test.ts\" \"supabase/functions/_shared/ai-inbound-flow.test.ts\" \"supabase/functions/_shared/ai-inbound-webhook.test.ts\" \"supabase/functions/_shared/ai-call-meter.test.ts\" \"supabase/functions/_shared/voice-campaign-core.test.ts\" \"supabase/functions/_shared/voice-campaign-flow.test.ts\" \"supabase/functions/_shared/voice-campaign-enroll.test.ts\" \"supabase/functions/_shared/ai-lead-effect.test.ts\" \"supabase/functions/_shared/voice-campaign-mission.test.ts\" \"supabase/functions/_shared/sms-ai-core.test.ts\" \"supabase/functions/_shared/campaign-sms.test.ts\"",
    "test:aimeter": "node --test \"test/ai-meter.test.mjs\"",
    "test:voicecampaigns": "node --test \"test/voice-campaigns.test.mjs\"",
    "test:defaultcampaigns": "node --test \"test/default-campaigns.test.mjs\"",
    "test:leadfilters": "node --test \"test/lead-filters.test.mjs\"",
    "test:auth": "node --test \"supabase/functions/_shared/auth-verify.test.ts\"",
    "test:compliance": "node --test \"supabase/functions/_shared/compliance-page.test.ts\"",
    "test:a2p": "node --test \"supabase/functions/_shared/a2p-registration.test.ts\"",
    "test:leadtransfer": "node --test \"supabase/functions/_shared/lead-transfer.test.ts\"",
    "test:team": "node --test \"test/team-roster.test.mjs\"",
    "test:backoffice": "node --test \"supabase/functions/_shared/statement-core.test.ts\" \"supabase/functions/_shared/statement-ai.test.ts\" \"supabase/functions/_shared/statement-email.test.ts\" \"test/back-office.test.mjs\"",
    "test:bob": "node --test \"test/book-of-business.test.mjs\"",
    "test:commissions": "node --test \"test/commissions.test.mjs\"",
    "test:persistency": "node --test \"test/persistency.test.mjs\"",
    "test:recon": "node --test \"test/reconciliation.test.mjs\"",
    "test:referrals": "node --test \"test/referrals.test.mjs\"",
    "test": "npm run test:email && npm run test:messaging && npm run test:ai && npm run test:compliance && npm run test:a2p && npm run test:leadtransfer && npm run test:team && npm run test:backoffice && npm run test:producercodes && npm run test:bob && npm run test:commissions && npm run test:persistency && npm run test:recon && npm run test:referrals && npm run test:leaderboards && npm run test:identity && npm run test:aimeter && npm run test:voicecampaigns && npm run test:defaultcampaigns && npm run test:mission && npm run test:leadfilters && npm run test:dialer && npm run test:auth && npm run test:bonus && npm run test:checkout && npm run test:embedded && npm run test:emailverify && npm run test:smsai && npm run test:smscampaigns && npm run test:defaultsms && npm run test:office && npm run check",
    "prebuild": "node scripts/prebuild.js",
    "sync:ai-assistant": "node scripts/sync-ai-assistant.mjs",
    "build": "npx cap sync",
    "cap:sync": "npm run prebuild && npx cap sync",
    "cap:android": "npm run cap:sync && npx cap open android",
    "cap:ios": "npm run cap:sync && npx cap open ios",
    "test:producercodes": "node --test \"test/producer-codes.test.mjs\"",
    "test:leaderboards": "node --test \"test/leaderboards.test.mjs\"",
    "test:identity": "node --test \"test/identity-periods.test.mjs\"",
    "test:bonus": "node --test \"test/bonus-tracker.test.mjs\"",
    "test:dialer": "node --test \"test/web-dialer.test.mjs\"",
    "test:mission": "node --test \"test/campaign-mission-control.test.mjs\"",
    "test:checkout": "node --test \"test/checkout-complete.test.mjs\"",
    "test:embedded": "node --test \"test/embedded-checkout.test.mjs\"",
    "test:emailverify": "node --test \"test/email-verification.test.mjs\"",
    "test:smsai": "node --test \"test/sms-ai-responder.test.mjs\"",
    "test:smscampaigns": "node --test \"test/sms-campaigns.test.mjs\"",
    "test:defaultsms": "node --test \"test/default-sms-campaigns.test.mjs\"",
    "test:office": "node --test \"test/office-split.test.mjs\""
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/browser": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/ios": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "eslint": "^9.39.4",
    "globals": "^17.7.0"
  }
}
